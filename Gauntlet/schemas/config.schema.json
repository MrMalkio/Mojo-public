{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mojo:testing-suite:config:v1",
  "title": "Testing suite config v1",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repositories",
    "policy",
    "runners"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "full_suite_every_days": {
          "type": "integer",
          "minimum": 1
        },
        "always_include_critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string"
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "description": "Built-in case observers: unittest and pytest, with verbose output. Other values cannot establish a strict passing gate."
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
