{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mojo:testing-suite:graph:v1",
  "title": "Testing suite graph v1",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "edges",
    "parity_groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "kind": {
            "enum": [
              "product",
              "system",
              "repository",
              "capability",
              "instance",
              "page",
              "ui",
              "action",
              "function",
              "block",
              "data",
              "api",
              "service",
              "resource",
              "invariant",
              "test",
              "file"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "critical": {
            "type": "boolean"
          },
          "new": {
            "type": "boolean"
          },
          "last_status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "runner": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "behavior": {
            "type": [
              "object",
              "string"
            ]
          },
          "parity_group": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "relation": {
            "enum": [
              "contains",
              "implements",
              "depends_on",
              "invokes",
              "reads",
              "writes",
              "consumes",
              "provides",
              "covers",
              "verifies"
            ]
          },
          "evidence": {
            "type": [
              "object",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "parity_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "instances",
          "shared_invariants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "uniqueItems": true
          },
          "shared_invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "uniqueItems": true
          },
          "variances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "instance",
                "invariant",
                "reason",
                "test"
              ],
              "properties": {
                "instance": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S+$"
                },
                "invariant": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S+$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S+$"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
